# secrets — never commit
.env
.env.local
.env.*.local
!.env.example

# python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
*.egg-info/

# node
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

# ingest working data (large, regenerable)
# Root-scoped: the ingest working set only. `web/data/` holds the shipped console artifact
# and must stay tracked, and git cannot re-include a file under an ignored directory.
/data/
checkpoints/
*.ndjson
*.ndjson.gz

# os / editor
.DS_Store
*.swp

# The console artifact (75MB) is committed deliberately: a cold clone can run the console and
# reproduce the query results without first sitting through the multi-hour ingest.
# Regenerate with `uv run blastradius webdb`.

# SQLite sidecars are runtime state, never artifacts
*.db-wal
*.db-shm
